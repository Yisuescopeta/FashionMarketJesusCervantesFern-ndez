---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { Send, Info, Mail, Users } from "lucide-react";

export const prerender = false;
---

<AdminLayout title="Marketing & Correos">
    <!-- Header -->
    <div class="mb-8">
        <h1
            class="text-xl sm:text-2xl font-bold text-slate-800 font-serif italic"
        >
            Marketing & Comunicaciones
        </h1>
        <p class="text-[10px] sm:text-sm text-slate-500">
            Crea campañas de correo personalizadas.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Panel de Envío Masivo -->
        <div class="lg:col-span-2">
            <div
                class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm border-t-4 border-t-brand-gold"
            >
                <div class="flex items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
                    <div
                        class="w-10 h-10 sm:w-12 sm:h-12 bg-amber-50 rounded-2xl flex items-center justify-center shadow-sm flex-shrink-0"
                    >
                        <Send
                            className="w-5 h-5 sm:w-6 sm:h-6 text-brand-gold"
                        />
                    </div>
                    <div>
                        <h3
                            class="text-base sm:text-lg font-bold text-slate-800"
                        >
                            Nueva Campaña
                        </h3>
                        <p
                            class="text-[9px] sm:text-[10px] text-slate-400 font-bold uppercase tracking-widest"
                        >
                            Envío masivo a todos
                        </p>
                    </div>
                </div>

                <form id="broadcastForm" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                                >Título de la Cabecera</label
                            >
                            <input
                                type="text"
                                name="title"
                                placeholder="Ej: Nueva Colección de Verano"
                                class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-gold outline-none text-sm transition-all"
                                required
                            />
                        </div>
                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                                >Asunto del Correo</label
                            >
                            <input
                                type="text"
                                name="subject"
                                placeholder="Ej: ¡Llegó lo que esperabas!"
                                class="w-full border border-slate-200 rounded-xl p-3 focus:ring-2 focus:ring-brand-gold outline-none text-sm transition-all"
                                required
                            />
                        </div>
                    </div>

                    <div>
                        <label
                            class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                            >Cuerpo del Mensaje</label
                        >
                        <textarea
                            name="message"
                            rows="10"
                            class="w-full border border-slate-200 rounded-xl p-4 focus:ring-2 focus:ring-brand-gold outline-none text-sm transition-all resize-none"
                            placeholder="Escribe aquí el contenido de tu correo..."
                            required></textarea>
                        <div
                            class="flex items-center gap-2 mt-2 text-slate-400"
                        >
                            <Info className="w-3.5 h-3.5" />
                            <p class="text-[10px] font-medium font-bold italic">
                                Se respetarán los saltos de línea automáticos.
                            </p>
                        </div>
                    </div>

                    <!-- Configuración de Cupón -->
                    <div
                        class="bg-slate-50 p-6 rounded-2xl border border-slate-100"
                    >
                        <div class="flex items-center gap-3 mb-4">
                            <input
                                type="checkbox"
                                id="include_coupon"
                                name="include_coupon"
                                class="w-5 h-5 accent-brand-gold cursor-pointer"
                            />
                            <label
                                for="include_coupon"
                                class="text-sm font-bold text-slate-700 cursor-pointer"
                            >
                                Incluir Cupón de Descuento
                            </label>
                        </div>

                        <div
                            id="coupon-settings"
                            class="hidden space-y-4 pl-8 border-l-2 border-slate-200"
                        >
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                                    >
                                        Tipo
                                    </label>
                                    <select
                                        name="coupon_type"
                                        class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm"
                                    >
                                        <option value="percent"
                                            >Porcentaje (%)</option
                                        >
                                        <option value="fixed"
                                            >Monto Fijo (€)</option
                                        >
                                    </select>
                                </div>
                                <label
                                    class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                                >
                                    Valor
                                </label>
                                <input
                                    type="number"
                                    id="coupon_value"
                                    name="coupon_value"
                                    placeholder="20"
                                    class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm mb-2"
                                />
                                <div class="flex gap-2">
                                    <button
                                        type="button"
                                        class="preset-btn bg-slate-100 text-[10px] px-2 py-1 rounded-md font-bold text-slate-600 hover:bg-slate-200"
                                        data-value="10">10%</button
                                    >
                                    <button
                                        type="button"
                                        class="preset-btn bg-slate-100 text-[10px] px-2 py-1 rounded-md font-bold text-slate-600 hover:bg-slate-200"
                                        data-value="15">15%</button
                                    >
                                    <button
                                        type="button"
                                        class="preset-btn bg-slate-100 text-[10px] px-2 py-1 rounded-md font-bold text-slate-600 hover:bg-slate-200"
                                        data-value="20">20%</button
                                    >
                                </div>
                            </div>
                        </div>

                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                            >
                                Estrategia de Código
                            </label>
                            <select
                                name="coupon_strategy"
                                id="coupon_strategy"
                                class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm"
                            >
                                <option value="generic"
                                    >Código Genérico (Mismo para todos)</option
                                >
                                <option value="unique"
                                    >Código Único (Personalizado por usuario)</option
                                >
                            </select>
                        </div>

                        <div id="generic-code-container">
                            <label
                                class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                            >
                                Código del Cupón
                            </label>
                            <input
                                type="text"
                                name="coupon_code"
                                placeholder="Ej: VERANO2025"
                                class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm font-mono uppercase"
                            />
                        </div>

                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest font-bold text-slate-500 mb-2"
                            >
                                Expiración (Opcional)
                            </label>
                            <input
                                type="date"
                                name="coupon_expiration"
                                class="w-full border border-slate-200 rounded-xl px-3 py-2 text-sm"
                            />
                        </div>
                    </div>
                    <div class="pt-2 sm:pt-6">
                        <button
                            type="submit"
                            id="submit-btn"
                            class="w-full bg-slate-900 text-white px-8 sm:px-12 py-3.5 sm:py-4 rounded-full font-bold uppercase tracking-widest text-[10px] sm:text-xs hover:bg-black transition-all shadow-xl shadow-slate-900/10 flex items-center justify-center gap-2 sm:gap-3 active:scale-95 group"
                        >
                            <span class="default-text">Enviar Campaña</span>
                            <Send
                                className="w-3.5 h-3.5 sm:w-4 sm:h-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                            />
                            <span class="loading-text hidden">Enviando...</span>
                        </button>
                    </div>
                </form>
                <div
                    id="formStatus"
                    class="hidden p-4 rounded-2xl text-xs font-bold uppercase tracking-widest text-center"
                >
                </div>
            </div>
        </div>
    </div>



        <!-- Consejo Pro -->
        <div
            class="bg-slate-900 rounded-3xl p-6 sm:p-8 text-white relative overflow-hidden shadow-xl shadow-slate-900/20 italic"
        >
            <div class="absolute -right-2 -bottom-2 opacity-10 hidden sm:block">
                <Info className="w-24 h-24" />
            </div>
            <h3
                class="text-sm sm:text-base font-bold mb-3 sm:mb-4 flex items-center gap-2"
            >
                <Info className="w-3.5 h-3.5 sm:w-4 sm:h-4 text-brand-gold" />
                Mejores Prácticas
            </h3>
            <p class="text-[11px] sm:text-xs text-slate-400 leading-relaxed">
                Evita enviar correos masivos más de una vez por semana. Los
                martes y jueves a las 10:00 AM suelen tener las mejores tasas de
                apertura.
            </p>
        </div>
    </div>
</AdminLayout>

<script>
    import { supabase } from "../../lib/supabase";

    // Manejo del formulario de broadcast
    const form = document.getElementById("broadcastForm") as HTMLFormElement;
    const statusDiv = document.getElementById("formStatus");
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement;

    // Coupon UI Logic
    const includeCouponCheckbox = document.getElementById(
        "include_coupon",
    ) as HTMLInputElement;
    const couponSettings = document.getElementById("coupon-settings");
    const couponStrategySelect = document.getElementById(
        "coupon_strategy",
    ) as HTMLSelectElement;
    const genericCodeContainer = document.getElementById(
        "generic-code-container",
    );

    includeCouponCheckbox?.addEventListener("change", () => {
        if (includeCouponCheckbox.checked) {
            couponSettings?.classList.remove("hidden");
        } else {
            couponSettings?.classList.add("hidden");
        }
    });

    couponStrategySelect?.addEventListener("change", () => {
        if (couponStrategySelect.value === "generic") {
            genericCodeContainer?.classList.remove("hidden");
        } else {
            genericCodeContainer?.classList.add("hidden");
        }
    });

    const couponValueInput = document.getElementById(
        "coupon_value",
    ) as HTMLInputElement;
    document.querySelectorAll(".preset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
            if (couponValueInput) {
                couponValueInput.value =
                    (btn as HTMLButtonElement).dataset.value || "";
            }
        });
    });

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submitBtn || !statusDiv) return;

        // UI Loading
        submitBtn.disabled = true;
        submitBtn.querySelector(".default-text")?.classList.add("hidden");
        submitBtn.querySelector("svg")?.classList.add("hidden");
        submitBtn.querySelector(".loading-text")?.classList.remove("hidden");
        statusDiv.classList.add("hidden");

        try {
            const formData = new FormData(e.target as HTMLFormElement);
            const data = Object.fromEntries(formData);

            // Obtener sesión para autenticación
            const {
                data: { session },
            } = await supabase.auth.getSession();
            const token = session?.access_token;

            const res = await fetch("/api/send-broadcast", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify(data),
            });

            const result = await res.json();

            statusDiv.classList.remove("hidden");
            if (res.ok) {
                statusDiv.className =
                    "mt-4 p-4 rounded-2xl text-[10px] font-bold uppercase tracking-widest text-center bg-emerald-50 text-emerald-600 border border-emerald-100";
                statusDiv.textContent = `¡Enviado con éxito a ${result.sent} usuarios!`;
                form.reset();
            } else {
                throw new Error(result.error || "Error al enviar");
            }
        } catch (error: any) {
            statusDiv.classList.remove("hidden");
            statusDiv.className =
                "mt-4 p-4 rounded-2xl text-[10px] font-bold uppercase tracking-widest text-center bg-rose-50 text-rose-600 border border-rose-100";
            statusDiv.textContent =
                error.message || "Error al enviar la campaña";
        } finally {
            submitBtn.disabled = false;
            submitBtn
                .querySelector(".default-text")
                ?.classList.remove("hidden");
            submitBtn.querySelector("svg")?.classList.remove("hidden");
            submitBtn.querySelector(".loading-text")?.classList.add("hidden");
        }
    });


</script>
