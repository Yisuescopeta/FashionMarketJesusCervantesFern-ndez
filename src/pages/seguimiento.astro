---
/**
 * Página de Seguimiento de Pedidos - AfterShip Integration
 *
 * Esta página permite a los clientes rastrear el estado de sus pedidos
 * utilizando el widget embebido de AfterShip.
 *
 * CONFIGURACIÓN REQUERIDA:
 * 1. Reemplazar 'TU-SLUG-AFTERSHIP' con el slug real de tu cuenta AfterShip
 * 2. El slug se obtiene de tu panel de AfterShip > Tracking Pages > Custom Domain
 *
 * TESTING:
 * - Usa números de tracking de prueba proporcionados por AfterShip
 * - O crea shipments de prueba en modo sandbox
 */

import PublicLayout from "../layouts/PublicLayout.astro";

// CONFIGURACIÓN: Reemplaza con tu slug de AfterShip
const AFTERSHIP_SLUG = "jesuscervantesfernan";

// URL base de la página de tracking de AfterShip
const AFTERSHIP_TRACKING_URL = `https://jesuscervantesfernan.aftership.com/`;
---

<PublicLayout
  title="Seguimiento de Pedidos | Aurum"
  description="Rastrea el estado de tu pedido en tiempo real"
>
  <section class="seguimiento-hero">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl md:text-4xl font-serif text-brand-navy mb-4">
        Seguimiento de Pedidos
      </h1>
      <p class="text-brand-charcoal text-lg">
        Introduce tu número de seguimiento para conocer el estado de tu envío
      </p>
    </div>
  </section>

  <section class="seguimiento-container">
    <div class="max-w-4xl mx-auto">
      <!-- Pestañas o Selector de Método -->
      <div class="flex border-b border-slate-100 mb-8 text-sm">
        <button
          id="tab-aftership"
          class="px-6 py-3 font-bold border-b-2 border-brand-navy text-brand-navy transition-all"
        >
          Nº SEGUIMIENTO (AFTERSHIP)
        </button>
        <button
          id="tab-native"
          class="px-6 py-3 font-bold border-b-2 border-transparent text-slate-400 hover:text-brand-navy transition-all"
        >
          ID DE PEDIDO (INTERNO)
        </button>
      </div>

      <!-- Formulario de AfterShip (Visible por defecto) -->
      <div id="section-aftership" class="seguimiento-formulario">
        <form id="formSeguimiento" class="flex flex-col sm:flex-row gap-4">
          <div class="flex-1">
            <label for="numeroTracking" class="sr-only"
              >Número de seguimiento</label
            >
            <input
              type="text"
              id="numeroTracking"
              name="numeroTracking"
              placeholder="Introduce tu número de seguimiento de AfterShip"
              class="seguimiento-input"
            />
          </div>
          <button type="submit" class="btn-primary seguimiento-btn">
            Rastrear con AfterShip
          </button>
        </form>
      </div>

      <!-- Formulario Nativo (Oculto por defecto) -->
      <div id="section-native" class="seguimiento-formulario hidden">
        <form id="formNative" class="flex flex-col md:flex-row gap-4">
          <div class="flex-1">
            <input
              type="text"
              id="lookupOrderId"
              placeholder="ID de Pedido (ej: 1234...)"
              class="seguimiento-input mb-4 md:mb-0"
            />
          </div>
          <div class="flex-1">
            <input
              type="email"
              id="lookupEmail"
              placeholder="Email utilizado en la compra"
              class="seguimiento-input"
            />
          </div>
          <button type="submit" class="btn-primary seguimiento-btn">
            Buscar Pedido
          </button>
        </form>
      </div>

      <!-- Widget de AfterShip embebido -->
      <div id="wrapper-aftership" class="seguimiento-widget">
        <div id="aftership-widget-container">
          <iframe
            id="aftership-iframe"
            src={AFTERSHIP_TRACKING_URL}
            class="aftership-iframe"
            title="Seguimiento de pedidos AfterShip"
            loading="lazy"></iframe>
        </div>

        <!-- Mensaje de carga -->
        <div id="cargando-widget" class="seguimiento-cargando">
          <div class="animate-pulse flex flex-col items-center">
            <div
              class="h-8 w-8 border-4 border-brand-navy border-t-transparent rounded-full animate-spin mb-4"
            >
            </div>
            <p class="text-brand-charcoal">
              Cargando sistema de seguimiento...
            </p>
          </div>
        </div>
      </div>

      <!-- Contenedor Resultados Nativo (Oculto) -->
      <div id="wrapper-native" class="hidden mb-12">
        <div
          id="native-results"
          class="bg-white p-8 rounded-lg shadow-sm border border-slate-100 italic font-serif"
        >
          <!-- Dinámico -->
        </div>
      </div>

      <!-- Información adicional -->
      <div class="seguimiento-info">
        <div class="grid md:grid-cols-3 gap-6">
          <div class="info-card">
            <div class="info-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
                ></path>
              </svg>
            </div>
            <h3 class="font-serif text-lg text-brand-navy mb-2">
              Pedido Procesado
            </h3>
            <p class="text-sm text-brand-charcoal">
              Tu pedido ha sido confirmado y está siendo preparado para envío.
            </p>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"
                ></path>
              </svg>
            </div>
            <h3 class="font-serif text-lg text-brand-navy mb-2">En Tránsito</h3>
            <p class="text-sm text-brand-charcoal">
              Tu paquete está en camino. Puedes seguir su ubicación en tiempo
              real.
            </p>
          </div>

          <div class="info-card">
            <div class="info-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h3 class="font-serif text-lg text-brand-navy mb-2">Entregado</h3>
            <p class="text-sm text-brand-charcoal">
              Tu pedido ha sido entregado con éxito. ¡Gracias por tu compra!
            </p>
          </div>
        </div>
      </div>

      <!-- Ayuda y contacto -->
      <div class="seguimiento-ayuda">
        <h2 class="font-serif text-xl text-brand-navy mb-4">
          ¿Necesitas ayuda?
        </h2>
        <p class="text-brand-charcoal mb-4">
          Si tienes problemas con el seguimiento de tu pedido o no has recibido
          tu número de tracking, no dudes en contactarnos.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/contacto?subject=Estado de Pedido" class="btn-secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            Contactar Soporte
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

<style>
  /* Estilos específicos para la página de seguimiento */

  .seguimiento-hero {
    @apply py-12 px-6 bg-gradient-to-b from-brand-offwhite to-white;
  }

  .seguimiento-container {
    @apply px-6 pb-16;
  }

  .seguimiento-formulario {
    @apply bg-white p-6 rounded-lg shadow-sm border border-slate-100 mb-8;
  }

  .seguimiento-input {
    @apply w-full px-4 py-3 border border-slate-200 rounded-lg 
           focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-transparent
           placeholder-slate-400 text-brand-navy;
  }

  .seguimiento-btn {
    @apply flex items-center justify-center whitespace-nowrap rounded-lg;
  }

  .seguimiento-widget {
    @apply bg-white rounded-lg shadow-sm border border-slate-100 mb-8 overflow-hidden relative;
    min-height: 500px;
  }

  .aftership-iframe {
    @apply w-full border-0;
    height: 600px;
    min-height: 500px;
  }

  .seguimiento-cargando {
    @apply absolute inset-0 flex items-center justify-center bg-white;
    display: none;
  }

  .seguimiento-info {
    @apply mb-8;
  }

  .info-card {
    @apply bg-white p-6 rounded-lg shadow-sm border border-slate-100 text-center;
  }

  .info-icon {
    @apply w-12 h-12 mx-auto mb-4 bg-brand-offwhite rounded-full 
           flex items-center justify-center text-brand-navy;
  }

  .seguimiento-ayuda {
    @apply bg-brand-offwhite p-8 rounded-lg text-center;
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center px-6 py-3 
           border border-brand-navy text-brand-navy rounded-lg
           hover:bg-brand-navy hover:text-white transition-colors;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .aftership-iframe {
      height: 500px;
    }

    .seguimiento-formulario {
      @apply p-4;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Selectores
    const tabAfterShip = document.getElementById("tab-aftership");
    const tabNative = document.getElementById("tab-native");
    const sectionAfterShip = document.getElementById("section-aftership");
    const sectionNative = document.getElementById("section-native");
    const wrapperAfterShip = document.getElementById("wrapper-aftership");
    const wrapperNative = document.getElementById("wrapper-native");

    const formAfterShip = document.getElementById("formSeguimiento");
    const formNative = document.getElementById("formNative");
    const iframe = document.getElementById("aftership-iframe");
    const cargando = document.getElementById("cargando-widget");
    const nativeResults = document.getElementById("native-results");

    // Manejo de Pestañas
    tabAfterShip?.addEventListener("click", () => {
      tabAfterShip.classList.add("border-brand-navy", "text-brand-navy");
      tabAfterShip.classList.remove("border-transparent", "text-slate-400");
      tabNative.classList.remove("border-brand-navy", "text-brand-navy");
      tabNative.classList.add("border-transparent", "text-slate-400");

      sectionAfterShip.classList.remove("hidden");
      wrapperAfterShip.classList.remove("hidden");
      sectionNative.classList.add("hidden");
      wrapperNative.classList.add("hidden");
    });

    tabNative?.addEventListener("click", () => {
      tabNative.classList.add("border-brand-navy", "text-brand-navy");
      tabNative.classList.remove("border-transparent", "text-slate-400");
      tabAfterShip.classList.remove("border-brand-navy", "text-brand-navy");
      tabAfterShip.classList.add("border-transparent", "text-slate-400");

      sectionNative.classList.remove("hidden");
      wrapperNative.classList.remove("hidden");
      sectionAfterShip.classList.add("hidden");
      wrapperAfterShip.classList.add("hidden");
    });

    // --- Lógica AfterShip ---
    if (iframe) {
      iframe.addEventListener("load", () => {
        if (cargando) cargando.style.display = "none";
      });
    }

    formAfterShip?.addEventListener("submit", (e) => {
      e.preventDefault();
      const numeroTracking = document
        .getElementById("numeroTracking")
        .value.trim();
      if (numeroTracking && iframe) {
        // Obtenemos la URL base desde el iframe actual o recalculamos
        const baseUrl = iframe.src
          .split("?")[0]
          .split("#")[0]
          .replace(/\/$/, "");
        iframe.src = `${baseUrl}/${numeroTracking}`;
        if (cargando) cargando.style.display = "flex";
      }
    });

    // --- Lógica Nativa (Supabase) ---
    formNative?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const orderId = document.getElementById("lookupOrderId").value.trim();
      const email = document.getElementById("lookupEmail").value.trim();

      if (!orderId || !email) return;

      if (nativeResults) {
        nativeResults.innerHTML =
          '<div class="flex justify-center py-4"><div class="animate-spin h-6 w-6 border-2 border-brand-navy border-t-transparent rounded-full"></div></div>';
      }
      wrapperNative?.classList.remove("hidden");

      try {
        const resp = await fetch("/api/orders/lookup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ orderId, email }),
        });

        const data = await resp.json();

        if (resp.ok && nativeResults) {
          const { order } = data;
          const statusMap = {
            pending: "Pendiente",
            paid: "Pagado",
            confirmed: "Confirmado",
            processing: "En Preparación",
            shipped: "Enviado",
            delivered: "Entregado",
            cancelled: "Cancelado",
          };

          nativeResults.innerHTML = `
            <div class="space-y-6 not-italic font-sans">
              <div class="flex justify-between items-start border-b border-slate-100 pb-4">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Estado Actual</p>
                  <span class="px-3 py-1 bg-brand-navy text-white text-xs font-bold uppercase tracking-widest rounded-full">
                    ${statusMap[order.status] || order.status}
                  </span>
                </div>
                <div class="text-right">
                  <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">ID de Pedido</p>
                  <p class="text-sm font-mono font-bold">#${order.id.substring(0, 8)}...</p>
                </div>
              </div>
              
              <div class="grid grid-cols-2 gap-4 text-sm">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Fecha</p>
                  <p class="font-medium">${new Date(order.date).toLocaleDateString()}</p>
                </div>
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Total</p>
                  <p class="font-medium">${(order.total / 100).toFixed(2)}€</p>
                </div>
              </div>

              ${
                order.tracking_number
                  ? `
                <div class="bg-brand-offwhite p-4 rounded border border-brand-navy/10">
                  <p class="text-[10px] font-bold uppercase tracking-widest text-brand-navy mb-2">Información de Envío</p>
                  <p class="text-sm mb-1 text-slate-700">Número de seguimiento: <strong>${order.tracking_number}</strong></p>
                  ${order.tracking_url ? `<a href="${order.tracking_url}" target="_blank" class="text-xs text-brand-gold underline font-bold">Rastrear en transportista ↗</a>` : ""}
                </div>
              `
                  : `
                <div class="bg-slate-50 p-4 rounded border border-slate-200">
                  <p class="text-xs text-slate-500 italic">Aún no se ha asignado un número de seguimiento. Te avisaremos por email cuando el pedido sea enviado.</p>
                </div>
              `
              }

              <div class="pt-2">
                <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-2">Artículos</p>
                <div class="space-y-2">
                  ${order.items
                    .map(
                      (item) => `
                    <div class="flex justify-between text-xs py-1 border-b border-slate-50">
                      <span>${item.products.name} x${item.quantity}</span>
                      <span class="font-mono">${(item.price / 100).toFixed(2)}€</span>
                    </div>
                  `,
                    )
                    .join("")}
                </div>
              </div>
            </div>
          `;
        } else if (nativeResults) {
          nativeResults.innerHTML = `<div class="text-red-600 text-sm py-4 text-center font-sans not-italic">${data.error || "Error al buscar el pedido"}</div>`;
        }
      } catch (err) {
        if (nativeResults) {
          nativeResults.innerHTML =
            '<div class="text-red-600 text-sm py-4 text-center">Error de conexión al servidor</div>';
        }
      }
    });
  });
</script>
